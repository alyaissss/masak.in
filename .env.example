APP_NAME=MASAK
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────
# Sesuai SRS: MySQL. Buat database `masak` lalu jalankan
# `php artisan migrate --seed`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masak
DB_USERNAME=root
DB_PASSWORD=

# Alternatif tanpa server MySQL (sesi cepat / demo):
#   DB_CONNECTION=sqlite
#   (hapus DB_HOST..DB_PASSWORD, jalankan: touch database/database.sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
